# Maintainer: leetrat
pkgname=aula-f87
pkgver=0.1.0
pkgrel=1
pkgdesc='Persistent onboard RGB control for the AULA F87 Pro (CLI and GTK frontend)'
arch=('any')
url='https://github.com/leetrat/aula-f87-rgb'
license=('MIT')
depends=('python')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=(
  'python-gobject: GTK frontend'
  'gtk4: GTK frontend'
  'libadwaita: GTK frontend'
  'python-cairo: GTK frontend'
)
install=aula-f87.install
source=("$pkgname-$pkgver.tar.gz::https://github.com/leetrat/aula-f87-rgb/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('ee420db309752639faa873e1d9b8016ee8e9b559d7ee5822513c3aa7f66dc1aa')

build() {
  cd "aula-f87-rgb-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "aula-f87-rgb-$pkgver"
  python -m unittest discover -s tests -q
}

package() {
  cd "aula-f87-rgb-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 aula-f87.desktop "$pkgdir/usr/share/applications/aula-f87.desktop"
  install -Dm644 udev/60-aula-f87.rules "$pkgdir/usr/lib/udev/rules.d/60-aula-f87.rules"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
